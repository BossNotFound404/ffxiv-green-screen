<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <DalamudLibPath Condition="'$(DalamudLibPath)' == ''">$(AppData)\XIVLauncher\addon\Hooks\dev</DalamudLibPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../RoundTableStudio/SkillExposure.cs" Link="SkillExposure.cs" />
    <Compile Include="../RoundTableStudio/StudioFrameReader.cs" Link="StudioFrameReader.cs" />
    <Reference Include="Dalamud;FFXIVClientStructs;InteropGenerator.Runtime">
      <HintPath>$(DalamudLibPath)\%(Identity).dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
